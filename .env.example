# Copy to .env.local and fill in your Firebase project values
# Firebase Console → Project Settings → Your Apps → Web App → SDK config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=qunjeebook.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qunjeebook
VITE_FIREBASE_STORAGE_BUCKET=qunjeebook.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Realtime Database — used only for the live support chat (Firestore holds
# everything else). Console → Realtime Database → Data tab → URL at the top.
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.your-region.firebasedatabase.app

# FCM Web Push — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key_here

# EmailJS — emailjs.com (free tier)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_BOOKING_TEMPLATE=template_booking_confirm
VITE_EMAILJS_CONFIRMED_TEMPLATE=template_admin_confirm
VITE_EMAILJS_CANCELLED_TEMPLATE=template_booking_cancel

# EmailJS — Qunjee Eats order templates (optional; senders no-op if unset)
VITE_EMAILJS_ORDER_TEMPLATE=template_order_confirm
VITE_EMAILJS_ORDER_STATUS_TEMPLATE=template_order_status
VITE_EMAILJS_ORDER_CANCELLED_TEMPLATE=template_order_cancel

# EmailJS — subscription invoice (optional; sender no-ops if unset). Create
# the template in the EmailJS dashboard with variables: invoice_ref,
# to_name, to_email, amount, period_start, period_end.
VITE_EMAILJS_INVOICE_TEMPLATE=template_invoice

# Sentry — sentry.io error tracking (optional; no-ops if unset).
# Project Settings → Client Keys (DSN) after creating a React project.
VITE_SENTRY_DSN=

# App Check — reCAPTCHA Enterprise site key (public). Not used against the emulator.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Local development: point the app at the Firebase Emulator (npm run emulator)
# instead of production. Keep this true for all local work.
VITE_USE_FIREBASE_EMULATOR=true
